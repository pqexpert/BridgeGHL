# Example only: the OAuth gateway/auth_request implementation is environment-specific.
# Do not deploy this block until /_oauth2/auth and the OAuth 2.1 metadata/token
# validation path are configured and tested.
location /mcp {
    auth_request /_oauth2/auth;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
