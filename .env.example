# Environment variables (DO NOT COMMIT REAL VALUES)

# Bridge authentication
BRIDGE_API_KEY=

# HighLevel integration
HIGHLEVEL_PIT=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_BASE_URL=https://services.leadconnectorhq.com

# Explicit unattended-write allowlists
# Comma-separated exact HighLevel custom-field IDs. Leave blank to disable custom-field writes.
HIGHLEVEL_APPROVED_CUSTOM_FIELD_IDS=
# Comma-separated exact contact tag strings. Leave blank to disable contact-tag mutations.
HIGHLEVEL_APPROVED_CONTACT_TAGS=

# Execution posture
# Keep false until server-side secret binding, location mapping, audit path, and readback are verified.
LIVE_WRITE_ENABLED=false
HEALTHCHECK_TIMEOUT_SECONDS=5

# Server
PORT=8000

# Audit logging
AUDIT_LOG_PATH=/var/log/bridgeghl/audit.log
