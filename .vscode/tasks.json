{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ziji Fabric: local status (no inference)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/local_fabric_status.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ziji Fabric: pause local inference",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/local_fabric_control.py",
        "pause"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ziji Fabric: resume local inference",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/local_fabric_control.py",
        "resume"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
